# ==============================================================================
# KONFIGURASI LLM / MODEL AI UNTUK AGENTIC CTI
# ==============================================================================

# --- OPSI 1: CUSTOM ENDPOINT (Local On-Premise / Ollama / vLLM / LM Studio / Private Gateway) ---
# Sangat direkomendasikan untuk keamanan data SOC (100% offline & data tidak keluar ke internet)
# Contoh untuk Ollama Local:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=ollama/llama3.1
# LLM_API_KEY=NA

# Contoh untuk LM Studio / LocalAI / vLLM:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=openai/local-model
# LLM_API_KEY=NA

# Contoh untuk Private Enterprise / Corporate SOC Gateway:
# LLM_BASE_URL=https://llm-gateway.internal.corp/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_internal_gateway_token

# --- OPSI 2: CLOUD API STANDAR (OpenAI / Gemini / Anthropic) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Google Gemini:
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini/gemini-1.5-flash

# Anthropic Claude:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=anthropic/claude-3-5-sonnet-20241022

# ==============================================================================
# KONFIGURASI LOKASI LOG & CACHEDB
# ==============================================================================
N0Z0_ROOT=../
CACHEDB_ADDR=127.0.0.1:50051

# Webhook Alerting (Opsional untuk integrasi Discord / Telegram / SIEM SOAR)
# SOAR_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
